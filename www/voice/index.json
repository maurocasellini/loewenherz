"texts": {
"75844381": "use strict",
"2a0e96a8": "Sag heute zu jemandem laut und deutlich:",
"f9473f67": "Hallo!",
"de217ca7": "Frag ein anderes Kind:",
"105f8abb": "Willst du mit mir spielen?",
"2aef1bec": "Bestell selbst etwas beim Bäcker und sag Danke.",
"a481741a": "Erzähl beim Abendessen von deinem Tag.",
"bbf4111d": "Ruf Oma oder Opa an und erzähl einen Witz.",
"f3df3f16": "Sag jemandem, was du an ihm magst.",
"cebe73d8": "Frag einen Erwachsenen etwas, das du wissen willst.",
"5788be60": "Streck im Kindergarten oder in der Schule einmal die Hand hoch.",
"fdb0ae1e": "Probier ein Essen, das du noch nicht kennst.",
"19572787": "Kletter ein Stück höher als letztes Mal.",
"f99ebd41": "Hol allein etwas aus einem anderen Zimmer.",
"cbf9c6a5": "Sag freundlich und klar NEIN, wenn du etwas nicht willst.",
"9803ff79": "Mach etwas, das im Bauch kribbelt, und mach es trotzdem.",
"10ce2bc5": "Ich kann das!",
"3cd55ca6": "Zieh dich heute ganz allein an.",
"682cf9da": "Deck den Tisch für die ganze Familie.",
"a51f6186": "Bau einen hohen Turm.",
"0a97e990": "Wenn er umfällt:",
"48cdbc1e": "nochmal bauen!",
"c3c7b611": "Üb etwas, das du noch nicht kannst, dreimal hintereinander.",
"184ed8af": "Giess die Pflanzen ganz allein.",
"31165531": "Mach 10 Hampelmänner, so schnell du kannst.",
"7243003b": "Renn wie ein Löwe einmal ums Haus oder durch die Wohnung.",
"31c52efd": "Steh 10 Sekunden auf einem Bein wie ein Flamingo.",
"f133eef8": "Tanz wild zu deinem Lieblingslied.",
"24a7339f": "Hilf jemandem, ohne dass er fragt.",
"98d7ab4a": "Mal ein Bild für jemanden, den du lieb hast.",
"04b6e68a": "Schau in den Spiegel und sag:",
"42e12aff": "Ich bin super, so wie ich bin!",
"5c757a0e": "Tröste jemanden, der traurig ist.",
"5efa1881": "Mach absichtlich einen lustigen Fehler und lach darüber.",
"50f27ff2": "Erzähl, was heute nicht geklappt hat und was du daraus lernst.",
"fe8fef28": "ICH BIN MUTIG!",
"fe6b2131": "Ich probier's einfach!",
"99b777c7": "Fehler machen mich schlauer!",
"ede3f02e": "Ich bin gut, so wie ich bin!",
"074bc6ff": "Meine Stimme ist wichtig!",
"574311bb": "Ich bin stark!",
"169082fb": "Ich darf laut sein!",
"65308f53": "Ich hab mich lieb!",
"0875469c": "Ich schaff das, Schritt für Schritt!",
"09e6e18d": "ICH BIN EIN LÖWENHERZ!",
"14947c3a": "ICH TRAU MICH!",
"8e3268bf": "Juhu!",
"1095f1ef": "Freude wird grösser, wenn man sie teilt.",
"745324c7": "Erzähl jemandem, warum du so froh bist!",
"8baade75": "Frag:",
"edf7064a": "Was war der schönste Moment heute?",
"22e8e504": "Wow!",
"d7a0793d": "Stolz sein ist ein tolles Gefühl.",
"690e8f2a": "Das gehört ins Stolz-Glas!",
"41e65ef2": "Was genau hast du geschafft?",
"7cec6138": "Wie hast du das gemacht?",
"16a84fbb": "Kribbeln im Bauch heisst:",
"1b022605": "Gleich passiert etwas Spannendes.",
"c961f2b6": "Das ist der Mut, der aufwacht!",
"e71cad9a": "Sag:",
"a7537a2c": "Kribbeln und Mut gehören zusammen.",
"b2f25095": "Ich bin bei dir.",
"6db65758": "Angst ist okay.",
"e097ad30": "Auch Löwen haben manchmal Angst.",
"0e8d3c38": "Atme mit mir, dann wird dein Herz ruhiger.",
"0f049fc0": "Nicht wegreden.",
"990c0de1": "Du hast Angst.",
"670c975f": "Das verstehe ich.",
"d8177ba5": "Was würde dir helfen?",
"6cc8353c": "Traurig sein ist okay.",
"792ab796": "Tränen dürfen raus.",
"2eebbf04": "Frag nach einer ganz dicken Umarmung!",
"5327787b": "Erst trösten, dann fragen:",
"a50a5a26": "Magst du mir erzählen, was passiert ist?",
"29e3b175": "Wut ist Kraft!",
"e3867175": "Lass sie raus, ohne jemandem weh zu tun:",
"e45fdc39": "Stampf fünfmal ganz fest auf den Boden!",
"0a776834": "Grenze halten, Gefühl erlauben:",
"4cd0d28f": "Du darfst wütend sein.",
"80f877e4": "Hauen ist nicht okay.",
"54e52e88": "Auch Helden brauchen Pause.",
"da14e1ac": "Kuschel dich ein und tank neue Kraft.",
"0fd90937": "Heute weniger Programm, mehr Nähe.",
"c382d9f7": "Was war heute das Lustigste?",
"6cf8e728": "Wann warst du heute mutig?",
"731614ef": "Was möchtest du unbedingt mal lernen?",
"e049d06b": "Wenn du einen Tag lang ein Tier wärst:",
"a2a5fd70": "welches?",
"8d5dc19b": "Wer war heute nett zu dir?",
"91d531ee": "Was kannst du richtig gut?",
"a9649a82": "Was hat heute nicht geklappt?",
"38e51e21": "Was probierst du nächstes Mal?",
"4a6fe9c4": "Was macht dich glücklich?",
"6e98c03a": "Wenn du zaubern könntest:",
"a22ca521": "Was würdest du zaubern?",
"d20c9566": "Was magst du an dir am meisten?",
"9143c4a9": "Erzähl einen Traum, den du mal hattest!",
"8e2159db": "Was würdest du gern mal ganz allein machen?",
"bf6586ff": "Wem möchtest du heute Danke sagen?",
"048d5127": "Was war heute schwer?",
"da354d9d": "Erfinde eine Geschichte mit einem Drachen und einer Pizza!",
"5db1f64d": "Wenn du König wärst:",
"300f7775": "Welche Regel machst du?",
"5deda18d": "Wer ist dein bester Freund und warum?",
"4760d965": "Worauf freust du dich morgen?",
"693ad3ca": "Wovor hattest du Angst, als du klein warst?",
"1d4abb52": "Was war dein lustigster Fehler als Kind?",
"3ebc8d63": "Was magst du an mir am meisten?",
"2c72354d": "Wann warst du mal richtig mutig?",
"ef593554": "Was war dein Lieblingsspiel als Kind?",
"2f457a03": "Was hat bei dir heute nicht geklappt?",
"a3b82093": "Was konntest du früher nicht und heute schon?",
"1b998d58": "Worüber hast du heute gelacht?",
"74da08b1": "Wann warst du mal schüchtern?",
"04537133": "Was ist dein grösster Traum?",
"7a38885d": "Kleiner Löwe!",
"f381d5a4": "Mutiger Löwe!",
"4a48cf59": "Hallo Löwenkind!",
"ba7d4954": "Du bist der Löwenkönig!",
"483d27bb": "Sammle weiter für dein Stolz-Glas.",
"05c56fbd": "Alles, worauf du stolz bist",
"c93430aa": "Ich lese dir vor!",
"4f6d04cf": "Was machen wir heute?",
"890d2936": "Deine Mission:",
"1d4cac42": "Mission geschafft!",
"1a533b6c": "Du bist so mutig.",
"ac0ebf38": "Eine Murmel liegt jetzt in deinem Stolz-Glas.",
"1e27eb21": "Für heute hast du alle Missions-Sterne.",
"81e1efad": "Die Murmel kommt trotzdem ins Glas!",
"093c80fe": "Sag mir nach, ganz laut:",
"5d99f067": "Drücken & brüllen!",
"98e829e2": "Jetzt loslassen!",
"003babb4": "LAUTER!",
"8f6ef3b7": "RAAAWR!",
"6cc50fa2": "Super laut!",
"cebb4bb7": "Länger halten!",
"2fbd8b68": "Wie ist dein Wetter innen drin?",
"92d205e3": "Tipp auf ein Bild.",
"3b4a2211": "Tipp auf den Würfel!",
"a45e7947": "Toll erzählt!",
"72ae5b2b": "Noch eine Frage?",
"7cd0281e": "Riech an der Blume, puste die Kerze aus.",
"3706df5c": "Fünf Löwen-Atemzüge.",
"6731c6a7": "Riech an der Blume, und puste die Kerze aus.",
"384655e6": "Helden-Pose!",
"7d3dbdf3": "Halt sie, bis die Zahl bei null ist.",
"4336b011": "Du bist stark!",
"a4c039f0": "Du bist ein Superheld!",
"963bc402": "Spürst du, wie stark du dich fühlst?",
"7b676e2b": "Riech an der Blume…",
"d80b7933": "Und jetzt:",
"4120005b": "Löwen-Atem, HAAA!",
"b29a40cf": "Und jetzt der Löwen-Atem.",
"d9465424": "Zunge raus, HAAA!",
"5ccd7d56": "Ganz ruhig und stark!",
"da7d9d77": "Noch leer.",
"47565779": "Die erste Murmel wartet auf dich!",
"3eb1cc34": "Schau mal, wie viele Murmeln schon in deinem Stolz-Glas sind!",
"58845831": "Tipp auf eine Murmel.",
"1f0e8c4a": "Dein Stolz-Glas ist noch leer.",
"c38c1759": "Lass es uns füllen!",
"3ff1425d": "K wie Krähe",
"4bcff0b1": "Zungenspitze bleibt unten hinter den Zähnen.",
"a1f45afe": "Das K kommt ganz hinten aus dem Hals, wie ein kleines Husten.",
"83a2eeac": "Die Krähe ruft:",
"ee0c38ea": "K!",
"9bee08b1": "Jetzt du!",
"7a0b8e3d": "Ganz hinten im Hals:",
"40309ca2": "K, K, K.",
"776e30dc": "Wie ein kleines Husten:",
